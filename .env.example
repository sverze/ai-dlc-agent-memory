# Copy to .env and fill in. .env is gitignored; this template is committed.
# The demo (scripts/live_demo.py) and the gated tests AUTO-LOAD this .env — no need to
# `export` (shell exports still win if set). Source: prototype spec Appendix A.2.

# --- LLM providers ---
GEMINI_API_KEY=                       # Gemini Flash (BA agent) — free tier: 20 req/day/model
# GOOGLE_API_KEY=                     # accepted as fallback if GEMINI_API_KEY is unset
ANTHROPIC_API_KEY=                    # Claude Sonnet (SA agent + LLM judge) — pay-as-you-go
# OPENROUTER_API_KEY=                 # optional: cross-family judge (20% κ cross-check)

# --- Graph backend (Neo4j Community, local Docker) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# matches the docker-compose.yml local-dev default; change BOTH for anything shared
NEO4J_PASSWORD=devpassword

# --- Graphiti (point entity extraction at Gemini to stay on the free tier) ---
GRAPHITI_LLM_PROVIDER=google

# --- Observability (Langfuse) ---
# HOST MUST MATCH THE REGION YOUR KEYS BELONG TO, or auth 401s and traces never ingest:
#   US Cloud  → https://us.cloud.langfuse.com   |   EU Cloud → https://cloud.langfuse.com
#   self-host → http://localhost:3000
LANGFUSE_HOST=https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=                   # pk-lf-... (Project Settings → API Keys)
LANGFUSE_SECRET_KEY=                   # sk-lf-...

# --- Tools (post-gate, except JIRA which is direct-to-gate) ---
ATLASSIAN_URL=https://your-org.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=                  # one token covers JIRA + Confluence (unscoped = account capabilities)
# JIRA_TEST_TICKET=SCRUM-1            # optional: ticket key the gated live test fetches/publishes to
# CONFLUENCE_SPACE_KEY=SD             # optional: where ADR pages publish (else first space discovered)
NOTION_API_TOKEN=
MIRO_API_TOKEN=
